# URL publik Cloudflare Pages tanpa akhiran slash. Browser menggunakan URL HTTPS
# ini untuk memanggil Pages Function pada /api dan /uploads.
NEXT_PUBLIC_API_URL=https://your-project.pages.dev

# Hanya tersedia pada runtime Pages Function dan tidak masuk ke bundle browser.
# Boleh berupa HTTP selama VPS belum memiliki TLS; sebaiknya migrasikan ke HTTPS.
API_PROXY_TARGET=http://203.0.113.10
