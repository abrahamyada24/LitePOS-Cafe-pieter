{
  "name": "litepos-cafe-pieter-desktop",
  "version": "1.2.8",
  "description": "LitePOS desktop client for Cafe Pieter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.litepos.cafepieter",
    "productName": "LitePOS Cafe Pieter",
    "artifactName": "LitePOS-Cafe-Pieter-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "../pos-fe/public/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../pos-fe/public/icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
